# Opções mais comuns:
#   NOSASL  -> sem autenticação SASL
#   PLAIN   -> usuário/senha simples
#   GSSAPI  -> Kerberos
#DB_AUTH_MECHANISM=PLAIN

# Use true se o Impala exigir conexão SSL/TLS.
#DB_USE_SSL=false

# Opcional. Tempo limite da conexão, em segundos.
#DB_TIMEOUT=60
