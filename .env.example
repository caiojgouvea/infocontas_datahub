# -----------------------------
# INFOCONTAS DataHub - .env
# -----------------------------
# Obrigatórias (MinIO)

MINIO_ACCESS_KEY="tce_xx"
MINIO_SECRET_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MINIO_ENDPOINT="minio-arquivos-gi.tce.pb.gov.br"
MINIO_BUCKET=arquivos

# -----------------------------
# MinIO de destino (opcional)
# -----------------------------
# Se as 4 variáveis abaixo estiverem preenchidas, o comando "download" e
# "download-all-years" além de salvar em disco (DOWNLOAD_DIR) também espelham
# os arquivos baixados para este bucket próprio, no mesmo prefixo de partição.
# Deixe em branco/comentado para manter o comportamento padrão (somente disco).
# DEST_MINIO_ACCESS_KEY=
# DEST_MINIO_SECRET_KEY=
# DEST_MINIO_ENDPOINT=
# DEST_MINIO_BUCKET=
# Prefixo opcional dentro do bucket (o bucket em si não pode conter "/").
# Ex.: bucket "sigma" + prefix "infocontas" -> objetos salvos em sigma/infocontas/...
# DEST_MINIO_PREFIX=

# -----------------------------
# Tuning (opcionais)
# -----------------------------
# Não altera a lógica/semântica do fluxo. Apenas desempenho/memória.
EXTRACT_BATCH_ROWS=250000
ENGINE_CHUNK_ROWS=250000
MAX_INVALID_SAMPLES=50

CONTRACT_DIR=contract
LOG_DIR=log
OUTPUT_DIR=output
DOWNLOAD_DIR=download
DOWNLOAD_MAX_WORKERS=6

# -----------------------------
# BANCO DE DADOS (OBRIGATÓRIO)
# -----------------------------
DB_DIALECT=mssql
DB_HOST=xxxxxxxxxxxxxxxxxx
DB_NAME=xxxxxxxxxxxxxxxxxx
DB_USER=xxxxxxxxxxxxxxxxxx
DB_PASSWORD=xxxxxxxxxxxxxxxxxx
DB_TRUSTED_CONNECTION=false

# -----------------------------
# OPCIONAIS (GENÉRICOS)
# -----------------------------
DB_PORT=1435
DB_DRIVER=pyodbc
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

#---------------------------------
# USADOS PARA CONEXÃO IMPALA
#----------------------------
DB_AUTH_MECHANISM=PLAIN
DB_USE_SSL=false
DB_TIMEOUT=60

# ============================================================
# EXEMPLOS POR BANCO (use apenas um)
# ============================================================

# -----------------------------
# SQL SERVER
# -----------------------------
# DB_DIALECT=mssql
# DB_DRIVER=pyodbc
# DB_HOST=servidor
# DB_PORT=1433
# DB_NAME=SEUBANCO
# DB_USER=usuario
# DB_PASSWORD=senha
# DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=yes
# DB_SCHEMA=dbo

# -----------------------------
# POSTGRESQL
# -----------------------------
# DB_DIALECT=postgresql
# DB_DRIVER=psycopg
# DB_HOST=servidor
# DB_PORT=5432
# DB_NAME=seubanco
# DB_USER=usuario
# DB_PASSWORD=senha
# DB_SSLMODE=require
# DB_SCHEMA=public

# -----------------------------
# MYSQL
# -----------------------------
# DB_DIALECT=mysql
# DB_DRIVER=pymysql
# DB_HOST=servidor
# DB_PORT=3306
# DB_NAME=seubanco
# DB_USER=usuario
# DB_PASSWORD=senha

# -----------------------------
# ORACLE
# -----------------------------
# DB_DIALECT=oracle
# DB_DRIVER=oracledb
# DB_HOST=servidor
# DB_PORT=1521
# DB_USER=usuario
# DB_PASSWORD=senha
# DB_SERVICE_NAME=ORCLPDB1

# -----------------------------
# SQLITE (teste/local)
# -----------------------------
# DB_DIALECT=sqlite
# DB_SQLITE_PATH=./db.sqlite
# DB_SCHEMA=main


